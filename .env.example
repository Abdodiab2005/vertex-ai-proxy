# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=gemini_gateway
DB_SSL=false

# --- Cache / rate limiting (Redis) ---
REDIS_URL=redis://localhost:6379

# --- API server ---
NODE_ENV=development
PORT=3000

# Maximum JSON body size for public Gemini-compatible requests.
PUBLIC_MAX_REQUEST_BODY_BYTES=20971520
# Maximum JSON body size for the admin API and all other routes.
ADMIN_MAX_REQUEST_BODY_BYTES=1048576

# Express trust-proxy setting for forwarded client IP handling.
TRUST_PROXY=loopback

# Structured application log output. Production defaults to json when unset.
LOG_FORMAT=
# Include error stack traces in structured logs.
LOG_INCLUDE_STACK=false
# Bearer token for the Prometheus metrics endpoint; leave blank to disable it.
METRICS_TOKEN=
# On SIGTERM, how long requests in flight (streams included) may finish before they are cancelled
# and settled. Keep it below the orchestrator's kill timeout minus a few seconds.
SHUTDOWN_GRACE_MS=15000

# Fixed window length for failed admin login attempts.
ADMIN_LOGIN_WINDOW_SECONDS=900
# Maximum failed logins for one account and IP address.
ADMIN_LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=5
# Maximum failed logins for one account across all IP addresses.
ADMIN_LOGIN_MAX_FAILURES_PER_ACCOUNT=50
# Maximum failed logins from one IP address across accounts.
ADMIN_LOGIN_MAX_FAILURES_PER_IP=20

# Absolute lifetime of an admin session in hours.
ADMIN_SESSION_TTL_HOURS=12
# Override the admin cookie Secure attribute; unset follows NODE_ENV.
ADMIN_COOKIE_SECURE=

# 32-byte key used to encrypt upstream credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Admin panel (apps/admin) ---
# Where the admin app's server side reaches the API; read at runtime, never sent to browsers.
GATEWAY_API_URL=http://localhost:3000
