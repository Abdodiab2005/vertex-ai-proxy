# Build context is the repository root. Anything matched here never enters an
# image layer. Dependency installs and compilation happen inside the build stage.

.git
**/.git
node_modules
**/node_modules
dist
**/dist
.next
**/.next
out
**/out
coverage
**/coverage
*.log
**/*.log
*.tsbuildinfo
**/*.tsbuildinfo

# Real environment files and key material. .env.example is a template with
# placeholders, so it stays available to the build context.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

*.pem
**/*.pem
*.key
**/*.key
service-account*.json
**/service-account*.json
credentials*.json
**/credentials*.json
*.dump
**/*.dump

# A checkout can nest git worktrees; they are other branches, not this build.
.worktrees
**/worktrees

.DS_Store
.idea
.vscode
